MODULE TesseractMath;

// Multi-Surface RANSAC Plane Fitting
ROUTINE Tess_FitPlaneRANSAC(points_ptr: PTR, count: I32, iter: I32, thresh: F32) -> PLANE3D
BEGIN
    VAR best_plane: PLANE3D = PLANE_MAKE(0.0, 0.0, 1.0, 0.0);
    VAR max_inliers: I32 = 0;
    
    IF count < 3 THEN
        RETURN best_plane;
    ENDIF;

    LOOP iter TIMES
        VAR idx1: I32 = RANDOM_INT(0, count - 1);
        VAR idx2: I32 = RANDOM_INT(0, count - 1);
        VAR idx3: I32 = RANDOM_INT(0, count - 1);

        // Ensure unique index sampling
        IF idx1 == idx2 OR idx2 == idx3 OR idx1 == idx3 THEN
            CONTINUE;
        ENDIF;

        VAR p1: VEC3 = FETCH_VEC3(points_ptr, idx1);
        VAR p2: VEC3 = FETCH_VEC3(points_ptr, idx2);
        VAR p3: VEC3 = FETCH_VEC3(points_ptr, idx3);

        VAR v1: VEC3 = VEC3_SUB(p2, p1);
        VAR v2: VEC3 = VEC3_SUB(p3, p1);
        VAR norm: VEC3 = VEC3_CROSS(v1, v2);
        VAR len_sq: F32 = VEC3_DOT(norm, norm);

        // Avoid degenerate collinear vectors
        IF len_sq > 0.000001 THEN
            norm = VEC3_SCALE(norm, 1.0 / MATH_SQRT(len_sq));
            VAR d: F32 = -VEC3_DOT(norm, p1);
            VAR inliers: I32 = 0;

            FOR i FROM 0 TO count - 1 DO
                VAR pt: VEC3 = FETCH_VEC3(points_ptr, i);
                VAR dist: F32 = MATH_ABS(VEC3_DOT(norm, pt) + d);
                IF dist < thresh THEN
                    inliers = inliers + 1;
                ENDIF;
            ENDFOR;

            IF inliers > max_inliers THEN
                max_inliers = inliers;
                best_plane = PLANE_MAKE(norm.x, norm.y, norm.z, d);
            ENDIF;
        ENDIF;
    ENDLOOP;

    RETURN best_plane;
ENDROUTINE;

// Lens Distortion Correction with Iterative Safeguard
ROUTINE Tess_CorrectLensDistortion(u: F32, v: F32, fx: F32, fy: F32, cx: F32, cy: F32, k1: F32, k2: F32, p1: F32, p2: F32) -> VEC2
BEGIN
    VAR x: F32 = (u - cx) / fx;
    VAR y: F32 = (v - cy) / fy;
    VAR r2: F32 = (x * x) + (y * y);
    VAR r4: F32 = r2 * r2;

    VAR radial: F32 = 1.0 + (k1 * r2) + (k2 * r4);
    VAR x_dist: F32 = (x * radial) + (2.0 * p1 * x * y + p2 * (r2 + 2.0 * x * x));
    VAR y_dist: F32 = (y * radial) + (p1 * (r2 + 2.0 * y * y) + 2.0 * p2 * x * y);

    RETURN VEC2_MAKE((x_dist * fx) + cx, (y_dist * fy) + cy);
ENDROUTINE;

// Matrix Transformation Guard
ROUTINE Tess_TransformPointSafe(pt: VEC3, mat: MAT4, fallback_pt: VEC3) -> VEC3
BEGIN
    VAR res: VEC4 = MAT4_MUL_VEC4(mat, VEC4_MAKE(pt.x, pt.y, pt.z, 1.0));

    IF IS_NAN(res.x) OR IS_NAN(res.y) OR IS_NAN(res.z) OR IS_INF(res.w) OR MATH_ABS(res.w) < 0.000001 THEN
        RETURN fallback_pt;
    ENDIF;

    VAR inv_w: F32 = 1.0 / res.w;
    RETURN VEC3_MAKE(res.x * inv_w, res.y * inv_w, res.z * inv_w);
ENDROUTINE;

ENDMODULE;
