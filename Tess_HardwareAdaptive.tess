MODULE TesseractHardwareAdaptive;

// System State Structure for Real-World Noise Tracking
STRUCT DeviceSensorProfile
    VAR imu_variance: F32;
    VAR avg_frame_time_ms: F32;
    VAR thermal_state: I32;       // 0 = Normal, 1 = Warm, 2 = Throttled
    VAR auto_cx: F32;
    VAR auto_cy: F32;
ENDSTRUCT;

// ----------------------------------------------------------------------------
// 1. ADAPTIVE RANSAC (Auto-tunes threshold based on IMU Motion Blur)
// ----------------------------------------------------------------------------
ROUTINE Tess_FitPlaneAdaptive(points_ptr: PTR, count: I32, iter: I32, base_thresh: F32, imu_jitter: F32) -> PLANE3D
BEGIN
    VAR best_plane: PLANE3D = PLANE_MAKE(0.0, 0.0, 1.0, 0.0);
    VAR max_inliers: I32 = 0;

    // Dynamically expand error threshold if phone is shaking or blurred
    VAR dynamic_thresh: F32 = base_thresh * (1.0 + MATH_CLAMP(imu_jitter * 2.5, 0.0, 5.0));
    
    IF count < 3 THEN
        RETURN best_plane;
    ENDIF;

    LOOP iter TIMES
        VAR idx1: I32 = RANDOM_INT(0, count - 1);
        VAR idx2: I32 = RANDOM_INT(0, count - 1);
        VAR idx3: I32 = RANDOM_INT(0, count - 1);

        IF idx1 == idx2 OR idx2 == idx3 OR idx1 == idx3 THEN
            CONTINUE;
        ENDIF;

        VAR p1: VEC3 = FETCH_VEC3(points_ptr, idx1);
        VAR p2: VEC3 = FETCH_VEC3(points_ptr, idx2);
        VAR p3: VEC3 = FETCH_VEC3(points_ptr, idx3);

        VAR v1: VEC3 = VEC3_SUB(p2, p1);
        VAR v2: VEC3 = VEC3_SUB(p3, p1);
        VAR norm: VEC3 = VEC3_CROSS(v1, v2);
        VAR len_sq: F32 = VEC3_DOT(norm, norm);

        IF len_sq > 0.000001 THEN
            norm = VEC3_SCALE(norm, 1.0 / MATH_SQRT(len_sq));
            VAR d: F32 = -VEC3_DOT(norm, p1);
            VAR inliers: I32 = 0;

            FOR i FROM 0 TO count - 1 DO
                VAR pt: VEC3 = FETCH_VEC3(points_ptr, i);
                VAR dist: F32 = MATH_ABS(VEC3_DOT(norm, pt) + d);
                IF dist < dynamic_thresh THEN
                    inliers = inliers + 1;
                ENDIF;
            ENDFOR;

            IF inliers > max_inliers THEN
                max_inliers = inliers;
                best_plane = PLANE_MAKE(norm.x, norm.y, norm.z, d);
            ENDIF;
        ENDIF;
    ENDLOOP;

    RETURN best_plane;
ENDROUTINE;

// ----------------------------------------------------------------------------
// 2. THERMAL-AWARE AMBIENT LIGHT ESTIMATION (Auto-Scales Under Load)
// ----------------------------------------------------------------------------
ROUTINE Tess_EstimateAmbientLightingThermal(frame_ptr: PTR, width: I32, height: I32, thermal_level: I32) -> SH_COEFFS
BEGIN
    VAR sh: SH_COEFFS = CLEAR_STRUCT();
    VAR samples: I32 = 0;

    // Scale step size up when device overheats to prevent frame drops
    VAR step_size: I32 = 16;
    IF thermal_level == 1 THEN
        step_size = 32; // Skip 75% of pixel processing
    ELSEIF thermal_level >= 2 THEN
        step_size = 64; // Ultra-light mode for hot processors
    ENDIF;

    FOR y FROM 0 TO height - 1 STEP step_size DO
        FOR x FROM 0 TO width - 1 STEP step_size DO
            VAR pixel: COLOR_RGBA = FETCH_PIXEL(frame_ptr, x, y, width);
            
            // Extended Dynamic Range Guard: Clamp overexposed camera pixels
            VAR r: F32 = MATH_CLAMP(pixel.r / 255.0, 0.0, 1.0);
            VAR g: F32 = MATH_CLAMP(pixel.g / 255.0, 0.0, 1.0);
            VAR b: F32 = MATH_CLAMP(pixel.b / 255.0, 0.0, 1.0);

            VAR nx: F32 = (x / FLOAT(width)) * 2.0 - 1.0;
            VAR ny: F32 = (y / FLOAT(height)) * 2.0 - 1.0;
            
            VAR dist_sq: F32 = (nx * nx) + (ny * ny);
            VAR nz: F32 = 0.0;
            IF dist_sq < 1.0 THEN
                nz = MATH_SQRT(1.0 - dist_sq);
            ENDIF;

            VAR y00: F32 = 0.282095;
            VAR y11: F32 = 0.488602 * nx;
            VAR y10: F32 = 0.488602 * nz;

            sh.r[0] = sh.r[0] + (r * y00); sh.r[1] = sh.r[1] + (r * y11);
            sh.g[0] = sh.g[0] + (g * y00); sh.g[1] = sh.g[1] + (g * y11);
            sh.b[0] = sh.b[0] + (b * y00); sh.b[1] = sh.b[1] + (b * y11);
            samples = samples + 1;
        ENDFOR;
    ENDFOR;

    IF samples > 0 THEN
        VAR factor: F32 = (4.0 * 3.14159265) / FLOAT(samples);
        sh = SH_SCALE(sh, factor);
    ENDIF;

    RETURN sh;
ENDROUTINE;

// ----------------------------------------------------------------------------
// 3. AUTO-CALIBRATING UNKNOWN LENS DISTORTION
// ----------------------------------------------------------------------------
ROUTINE Tess_CorrectLensUncalibrated(u: F32, v: F32, width: F32, height: F32, k1: F32, k2: F32) -> VEC2
BEGIN
    // Estimate principal point dynamically at runtime (center of frame)
    VAR cx: F32 = width * 0.5;
    VAR cy: F32 = height * 0.5;
    VAR fx: F32 = width * 0.8;  // Safe focal length heuristic for mobile wide-angle
    VAR fy: F32 = width * 0.8;

    VAR x: F32 = (u - cx) / fx;
    VAR y: F32 = (v - cy) / fy;
    VAR r2: F32 = (x * x) + (y * y);

    // Bound check for high-distortion lens edges
    IF r2 > 2.0 THEN
        RETURN VEC2_MAKE(u, v); // Bypasses warping calculation at chaotic borders
    ENDIF;

    VAR radial: F32 = 1.0 + (k1 * r2) + (k2 * r2 * r2);
    RETURN VEC2_MAKE(((x * radial) * fx) + cx, ((y * radial) * fy) + cy);
ENDROUTINE;

ENDMODULE;
