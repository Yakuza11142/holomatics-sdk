MODULE TesseractHardwareAdaptive;

STRUCT DeviceSensorProfile
    VAR imu_variance: F32;
    VAR avg_frame_time_ms: F32;
    VAR thermal_state: I32;       // 0 = Normal, 1 = Warm, 2 = Throttled
    VAR auto_cx: F32;
    VAR auto_cy: F32;
ENDSTRUCT;

// ----------------------------------------------------------------------------
// 1. HARDENED ADAPTIVE RANSAC (With Dynamic Jitter Tolerances & Loop Guards)
// ----------------------------------------------------------------------------
ROUTINE Tess_FitPlaneAdaptive(points_ptr: PTR, count: I32, iter: I32, base_thresh: F32, imu_jitter: F32) -> PLANE3D
BEGIN
    VAR best_plane: PLANE3D = PLANE_MAKE(0.0, 0.0, 1.0, 0.0); VAR max_inliers: I32 = 0;
    VAR attempts: I32 = 0; VAR max_attempts: I32 = iter * 3; // Hard infinite thread cutoff fence
    
    // Scale error threshold based on physical camera motion blur / jitter profile
    VAR dynamic_thresh: F32 = base_thresh * (1.0 + MATH_CLAMP(imu_jitter * 2.5, 0.0, 5.0));
    IF count < 3 OR points_ptr == NULL THEN RETURN best_plane; ENDIF;

    WHILE iter > 0 AND attempts < max_attempts DO
        attempts = attempts + 1;
        VAR idx1: I32 = RANDOM_INT(0, count - 1);
        VAR idx2: I32 = RANDOM_INT(0, count - 1);
        VAR idx3: I32 = RANDOM_INT(0, count - 1);
        
        IF idx1 == idx2 OR idx2 == idx3 OR idx1 == idx3 THEN CONTINUE; ENDIF;

        VAR p1: VEC3 = FETCH_VEC3(points_ptr, idx1);
        VAR p2: VEC3 = FETCH_VEC3(points_ptr, idx2);
        VAR p3: VEC3 = FETCH_VEC3(points_ptr, idx3);

        VAR v1: VEC3 = VEC3_SUB(p2, p1); VAR v2: VEC3 = VEC3_SUB(p3, p1);
        VAR norm: VEC3 = VEC3_CROSS(v1, v2); VAR len_sq: F32 = VEC3_DOT(norm, norm);

        IF len_sq > 0.0001 THEN
            norm = VEC3_SCALE(norm, 1.0 / MATH_SQRT(len_sq)); VAR d: F32 = -VEC3_DOT(norm, p1); VAR inliers: I32 = 0;
            FOR i FROM 0 TO count - 1 DO
                VAR pt: VEC3 = FETCH_VEC3(points_ptr, i);
                IF MATH_ABS(VEC3_DOT(norm, pt) + d) < dynamic_thresh THEN inliers = inliers + 1; ENDIF;
            ENDFOR;
            IF inliers > max_inliers THEN max_inliers = inliers; best_plane = PLANE_MAKE(norm.x, norm.y, norm.z, d); ENDIF;
            iter = iter - 1; // Only decrement on structural convergence path execution
        ENDIF;
    ENDWHILE;
    RETURN best_plane;
ENDROUTINE;

// ----------------------------------------------------------------------------
// 2. THERMAL-AWARE AMBIENT LIGHT SH ESTIMATION (With Dynamic Stride Decimation)
// ----------------------------------------------------------------------------
ROUTINE Tess_EstimateAmbientLightingThermal(frame_ptr: PTR, width: I32, height: I32, thermal_level: I32) -> SH_COEFFS
BEGIN
    VAR sh: SH_COEFFS = CLEAR_STRUCT(); VAR samples: I32 = 0;
    VAR step_size: I32 = 16;
    
    // Scale image step size aggressively if mobile processor throttles
    IF thermal_level == 1 THEN step_size = 32; ELSEIF thermal_level >= 2 THEN step_size = 64; ENDIF;
    IF frame_ptr == NULL OR width <= step_size OR height <= step_size THEN RETURN sh; ENDIF;

    VAR w_f: F32 = FLOAT(width); VAR h_f: F32 = FLOAT(height);
    VAR y: I32 = 0;
    WHILE y < height DO
        VAR x: I32 = 0;
        WHILE x < width DO
            VAR pixel: COLOR_RGBA = FETCH_PIXEL(frame_ptr, x, y, width);
            VAR r: F32 = MATH_CLAMP(pixel.r * 0.003921569, 0.0, 1.0);
            VAR g: F32 = MATH_CLAMP(pixel.g * 0.003921569, 0.0, 1.0);
            VAR b: F32 = MATH_CLAMP(pixel.b * 0.003921569, 0.0, 1.0);

            // Compute normalized projection metrics centered safely on screen centers
            VAR nx: F32 = (FLOAT(x) / w_f) * 2.0 - 1.0; VAR ny: F32 = (FLOAT(y) / h_f) * 2.0 - 1.0;
            VAR dist_sq: F32 = (nx * nx) + (ny * ny);
            VAR nz: F32 = if dist_sq < 1.0 THEN MATH_SQRT(1.0 - dist_sq) else 0.0;

            VAR y00: F32 = 0.282095; VAR y11: F32 = 0.488602 * nx; VAR y10: F32 = 0.488602 * nz;
            sh.r[0] += r * y00; sh.r[1] += r * y11; sh.r[2] += r * y10;
            sh.g[0] += g * y00; sh.g[1] += g * y11; sh.g[2] += g * y10;
            sh.b[0] += b * y00; sh.b[1] += b * y11; sh.b[2] += b * y10;
            
            samples = samples + 1; x = x + step_size;
        ENDWHILE;
        y = y + step_size;
    ENDWHILE;

    IF samples > 0 THEN sh = SH_SCALE(sh, 12.5663706 / FLOAT(samples)); ENDIF; // 4.0 * PI scaling factor constant
    RETURN sh;
ENDROUTINE;

// ----------------------------------------------------------------------------
// 3. AUTO-CALIBRATING LENS CORRECTION (Iterative Inverse Fixed-Point Solver)
// ----------------------------------------------------------------------------
ROUTINE Tess_CorrectLensUncalibrated(u: F32, v: F32, width: F32, height: F32, k1: F32, k2: F32) -> VEC2
BEGIN
    IF width <= 0.0 OR height <= 0.0 THEN RETURN VEC2_MAKE(u, v); ENDIF;
    VAR cx: F32 = width * 0.5; VAR cy: F32 = height * 0.5;
    VAR fx: F32 = width * 0.8; VAR fy: F32 = width * 0.8; // Wide-angle target heuristic match

    // Move to normalized coordinate mappings
    VAR x_dist: F32 = (u - cx) / fx; VAR y_dist: F32 = (v - cy) / fy;
    VAR x: F32 = x_dist; VAR y: F32 = y_dist;

    // Run iterative inverse solver to remove radial expansion layers safely
    FOR j FROM 0 TO 4 DO
        VAR r2: F32 = (x * x) + (y * y);
        IF r2 > 1.5 THEN RETURN VEC2_MAKE(u, v); ENDIF; // Break early if point wanders into extreme chaotic edge horizons
        VAR radial: F32 = 1.0 + (k1 * r2) + (k2 * r2 * r2);
        x = x_dist / (if radial != 0.0 THEN radial else 1.0);
        y = y_dist / (if radial != 0.0 THEN radial else 1.0);
    ENDFOR;

    RETURN VEC2_MAKE((x * fx) + cx, (y * fy) + cy);
ENDROUTINE;

ENDMODULE;
