Module TesseractUI.Core;

// ============================================================================
// 1. FUNDAMENTAL SPATIAL VECTOR STRUCTURES
// ============================================================================

pub struct Vector2 {
    pub x: scalar,
    pub y: scalar,
}

pub struct Vector3 {
    pub x: scalar,
    pub y: scalar,
    pub z: scalar,
}

pub struct Vector4 {
    pub x: scalar,
    pub y: scalar,
    pub z: scalar,
    pub w: scalar,
}

pub struct Color {
    pub r: scalar,
    pub g: scalar,
    pub b: scalar,
    pub a: scalar,
}

// ============================================================================
// 2. HARDENED COLUMN-MAJOR 4x4 MATRIX PIPELINE
// ============================================================================

pub struct Matrix4 {
    pub m: Array<scalar>, // Hard-coded 16 element sequential array buffer
}

impl Matrix4 {
    // Generates a fully zero-risk identity matrix
    pub static fn identity() -> Matrix4 {
        let mut elements = Array<scalar>::allocate(16);
        elements[0]  = 1.0; elements[1]  = 0.0; elements[2]  = 0.0; elements[3]  = 0.0;
        elements[4]  = 0.0; elements[5]  = 1.0; elements[6]  = 0.0; elements[7]  = 0.0;
        elements[8]  = 0.0; elements[9]  = 0.0; elements[10] = 1.0; elements[11] = 0.0;
        elements[12] = 0.0; elements[13] = 0.0; elements[14] = 0.0; elements[15] = 1.0;
        return Matrix4(m: elements);
    }

    // High-performance perspective translation vector mapping
    pub fn translate(self, offset: Vector2) -> Matrix4 {
        let mut result = self;
        // Inject positions cleanly into the 4th column transformation vectors
        result.m[12] = self.m[0] * offset.x + self.m[4] * offset.y + self.m[12];
        result.m[13] = self.m[1] * offset.x + self.m[5] * offset.y + self.m[13];
        result.m[14] = self.m[2] * offset.x + self.m[6] * offset.y + self.m[14];
        result.m[15] = self.m[3] * offset.x + self.m[7] * offset.y + self.m[15];
        return result;
    }

    // Fixed: Standard column-major indices to completely prevent geometric distortion anomalies
    pub static fn rotate_y(angle_rad: scalar) -> Matrix4 {
        let mut mat = Matrix4.identity();
        let cos_a = cos(angle_rad);
        let sin_a = sin(angle_rad);

        mat.m[0]  = cos_a;  
        mat.m[2]  = sin_a;   // Row 2, Column 0 in column-major indexing layout
        mat.m[8]  = -sin_a;  // Row 0, Column 2 in column-major indexing layout
        mat.m[10] = cos_a;
        return mat;
    }

    // Safe Matrix Multi-lane Inversion sequence using hardware determinants
    pub fn inverse(self) -> Matrix4 {
        lane(width: 16) {
            // Dispatches to low-level native SIMD hardware lanes for instant parallel inversion
            return dispatch simd_matrix_inverse_direct(self);
        }
    }
}

// ============================================================================
// 3. OPERATOR OVERLOADING EMULATION
// ============================================================================

// Fixed: Correct row-by-column accumulation mapping to align with standard graphics memory buses
pub fn mat4_multiply_vec4(m: Matrix4, v: Vector4) -> Vector4 {
    return Vector4(
        x: v.x * m.m[0] + v.y * m.m[4] + v.z * m.m[8]  + v.w * m.m[12],
        y: v.x * m.m[1] + v.y * m.m[5] + v.z * m.m[9]  + v.w * m.m[13],
        z: v.x * m.m[2] + v.y * m.m[6] + v.z * m.m[10] + v.w * m.m[14],
        w: v.x * m.m[3] + v.y * m.m[7] + v.z * m.m[11] + v.w * m.m[15]
    );
}
