Module TesseractUI.Camera;

import "core.tess";

pub enum PrimitiveType {
    Line,
    Point,
    Triangle,
    Box,
    Sphere
}

pub struct RenderCommand {
    pub prim_type: PrimitiveType,
    pub world_pos: Vector3,
    pub dimensions: Vector3,
    pub color: Color,
}

pub type SpatialCamera {
    position: Vector3,
    fov: scalar,

    pub fn get_projection_matrix() -> Matrix4 {
        lane(width: 16) {
            return Matrix4.rotate_y(self.fov).translate(Vector2(self.position.x, self.position.y));
        }
    }

    pub fn project_point(self, point: Vector3) -> Vector2 {
        let proj_matrix = self.get_projection_matrix();
        let clip_x = point.x * proj_matrix.m[0] + point.y * proj_matrix.m[1] + point.z * proj_matrix.m[2] + proj_matrix.m[3];
        let clip_y = point.x * proj_matrix.m[4] + point.y * proj_matrix.m[5] + point.z * proj_matrix.m[6] + proj_matrix.m[7];
        let clip_w = point.x * proj_matrix.m[12] + point.y * proj_matrix.m[13] + point.z * proj_matrix.m[14] + proj_matrix.m[15];

        return Vector2(clip_x / clip_w, clip_y / clip_w);
    }

    pub fn draw_line(self, canvas: Canvas, start: Vector3, end: Vector3, color: Color) {
        let p1 = self.project_point(start);
        let p2 = self.project_point(end);
        let delta = Vector2(p2.x - p1.x, p2.y - p1.y);
        canvas.draw_rect(p1, delta, color);
    }

    pub fn draw_box(self, canvas: Canvas, center: Vector3, size: Vector3, color: Color) {
        let half = Vector3(size.x * 0.5, size.y * 0.5, size.z * 0.5);
        let c0 = self.project_point(Vector3(center.x - half.x, center.y - half.y, center.z - half.z));
        let c1 = self.project_point(Vector3(center.x + half.x, center.y - half.y, center.z - half.z));
        let c2 = self.project_point(Vector3(center.x + half.x, center.y + half.y, center.z - half.z));
        let c3 = self.project_point(Vector3(center.x - half.x, center.y + half.y, center.z - half.z));

        let c4 = self.project_point(Vector3(center.x - half.x, center.y - half.y, center.z + half.z));
        let c5 = self.project_point(Vector3(center.x + half.x, center.y - half.y, center.z + half.z));
        let c6 = self.project_point(Vector3(center.x + half.x, center.y + half.y, center.z + half.z));
        let c7 = self.project_point(Vector3(center.x - half.x, center.y + half.y, center.z + half.z));

        canvas.draw_rect(c0, Vector2(c2.x - c0.x, c2.y - c0.y), color);
        canvas.draw_rect(c4, Vector2(c6.x - c4.x, c6.y - c4.y), color);
        canvas.draw_rect(c0, Vector2(c4.x - c0.x, c4.y - c0.y), color);
        canvas.draw_rect(c1, Vector2(c5.x - c1.x, c5.y - c1.y), color);
        canvas.draw_rect(c2, Vector2(c6.x - c2.x, c6.y - c2.y), color);
        canvas.draw_rect(c3, Vector2(c7.x - c3.x, c7.y - c3.y), color);
    }

    pub fn draw_mesh(self, canvas: Canvas, mesh_data: tensor) {
        let transform = self.get_projection_matrix();
        canvas.draw_vector_hologram(mesh_data, transform);
    }

    pub fn draw_object(self, canvas: Canvas, command: RenderCommand) {
        match command.prim_type {
            PrimitiveType.Line => self.draw_line(canvas, command.world_pos, Vector3(command.world_pos.x + command.dimensions.x, command.world_pos.y + command.dimensions.y, command.world_pos.z + command.dimensions.z), command.color),
            PrimitiveType.Box => self.draw_box(canvas, command.world_pos, command.dimensions, command.color),
            PrimitiveType.Point => {
                let screen_p = self.project_point(command.world_pos);
                canvas.draw_rect(screen_p, Vector2(1.0, 1.0), command.color);
            },
            PrimitiveType.Triangle => {
                let p1 = self.project_point(command.world_pos);
                let p2 = self.project_point(Vector3(command.world_pos.x + command.dimensions.x, command.world_pos.y, command.world_pos.z));
                canvas.draw_rect(p1, Vector2(p2.x - p1.x, command.dimensions.y), command.color);
            },
            PrimitiveType.Sphere => {
                let screen_p = self.project_point(command.world_pos);
                canvas.draw_rect(screen_p, Vector2(command.dimensions.x, command.dimensions.x), command.color);
            }
        }
    }
}
