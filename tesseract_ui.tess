module TesseractUI;

pub import "core.tess";
pub import "layout.tess";
pub import "state.tess";
pub import "text.tess";
pub import "input.tess";
pub import "physics.tess";
pub import "assets.tess";
pub import "audio.tess";
pub import "particles.tess";
pub import "network.tess";
pub import "animation.tess";
pub import "camera.tess";
pub import "shaders.tess";

pub type TesseractApp {
    pub static fn run(root: Widget) -> int {
        let Canvas main_canvas = Canvas.init_native_window();
        
        loop {
            let Vector2 touch_position = System.poll_input();
            
            main_canvas.clear(Color(0.05, 0.05, 0.08, 1.0));
            root.render(main_canvas);
            main_canvas.swap_buffers();
        }

        return 0;
    }
}
