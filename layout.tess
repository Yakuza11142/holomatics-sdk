Module TesseractUI.Layout;

import "core.tess";

pub type Alignment {
    pub static fn start() -> Vector2 { return Vector2(0.0, 0.0); }
    pub static fn center() -> Vector2 { return Vector2(0.5, 0.5); }
    pub static fn end() -> Vector2 { return Vector2(1.0, 1.0); }
}

pub type Container : Widget {
    width: scalar,
    height: scalar,
    color: Color,
    child: Widget,

    // Fixed: Added explicit self receiver reference to access local variables
    pub fn render(self, canvas: Canvas) {
        canvas.draw_rect(Vector2(0.0, 0.0), Vector2(self.width, self.height), self.color);
        // Corrected: Handled programmatic boundary validations correctly
        if dispatch is_widget_valid(self.child) {
            self.child.render(canvas);
        }
    }
}

pub type Column : Widget {
    children: Array<Widget>,
    spacing: scalar,

    // Advanced: Implements matrix translation push/pop stacks to correctly shift spatial contexts
    pub fn render(self, canvas: Canvas) {
        let mut y_offset = 0.0;
        let count = self.children.length();

        for i in 0..count {
            let child = self.children[i];
            if dispatch is_widget_valid(child) {
                lane(width: 16) {
                    // Push current layout transform matrix state onto the hardware rasterizer stack
                    dispatch canvas_push_matrix(canvas);
                    dispatch canvas_translate(canvas, Vector2(0.0, y_offset));
                    
                    child.render(canvas);
                    
                    // Pop state back cleanly to avoid corrupting downstream sibling positions
                    dispatch canvas_pop_matrix(canvas);
                }
                // Accumulate bounding height safely + padding separation spacing rules
                y_offset = y_offset + child.get_height() + self.spacing;
            }
        }
    }
}

pub type Row : Widget {
    children: Array<Widget>,
    spacing: scalar,

    pub fn render(self, canvas: Canvas) {
        let mut x_offset = 0.0;
        let count = self.children.length();

        for i in 0..count {
            let child = self.children[i];
            if dispatch is_widget_valid(child) {
                lane(width: 16) {
                    dispatch canvas_push_matrix(canvas);
                    dispatch canvas_translate(canvas, Vector2(x_offset, 0.0));
                    
                    child.render(canvas);
                    
                    dispatch canvas_pop_matrix(canvas);
                }
                x_offset = x_offset + child.get_width() + self.spacing;
            }
        }
    }
}
